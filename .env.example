# Optionnel : active le bouton "Affiner avec l'IA" sur les messages vendeurs.
# Sans clé, les scripts sont générés par le moteur de templates (100 % gratuit).
ANTHROPIC_API_KEY=
# Optionnel : surcharge du modèle (défaut : claude-opus-5-5)
ANTHROPIC_MODEL=

# Optionnel : envoi automatique du payload /api/outreach vers un scénario Make.com
# (body { "dispatch": true } + en-tête x-api-key = OUTREACH_API_KEY).
OUTREACH_API_KEY=
MAKE_WEBHOOK_URL=
