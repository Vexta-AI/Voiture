# Optionnel : active le bouton "Affiner avec l'IA" sur les messages vendeurs.
# Sans clé, les scripts sont générés par le moteur de templates (100 % gratuit).
ANTHROPIC_API_KEY=
# Optionnel : surcharge du modèle (défaut : claude-opus-5-5)
ANTHROPIC_MODEL=

# --- Chasse automatique (cron Vercel -> Apify -> scoring -> Telegram) ---
# Généré et posé automatiquement dans Vercel lors de la création du projet :
CRON_SECRET=
INGEST_SECRET=
# Fourni par l'intégration Vercel Blob (store privé connecté au projet) :
BLOB_READ_WRITE_TOKEN=
# À renseigner par toi dans Vercel (Settings > Environment Variables) :
APIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optionnels :
# HUNT_AREA=44.901,-0.740,200         zone : latitude,longitude,rayon en km (défaut : 200 km autour de la Gironde)
# HUNT_MAX_ITEMS=50                   annonces max par recherche quotidienne
# HUNT_MARKET_MAX_ITEMS=30            annonces max par recherche de comparables (hebdo)
# APIFY_MAX_CHARGE_USD=1              plafond de dépense par run Apify
# HUNT_SOURCES=[...]                  tes propres URLs de recherche LeBonCoin (voir README)
# APP_URL=https://ton-domaine.fr      sinon l'URL de production Vercel est utilisée

# Optionnel : envoi automatique du payload /api/outreach vers un scénario Make.com
# (body { "dispatch": true } + en-tête x-api-key = OUTREACH_API_KEY).
OUTREACH_API_KEY=
MAKE_WEBHOOK_URL=
